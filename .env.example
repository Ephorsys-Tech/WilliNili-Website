# Server & Application Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (MongoDB)
# Example: mongodb://localhost:27017/willy_nilly or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/willy_nilly

# Admin Authentication & Security
# Generate a strong 32+ character random secret (e.g. openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
SESSION_MAX_AGE_SECONDS=86400

# Rate Limiting Configuration
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_PUBLIC_MAX=30
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60

# File Upload Hardening (Max 5MB)
UPLOAD_MAX_BYTES=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Default Dynamic Theme (nature, luxury, earth, ocean)
NEXT_PUBLIC_DEFAULT_THEME=nature

# Cloudinary Media Storage (Optional with safe local disk fallback)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=willy_nilly
